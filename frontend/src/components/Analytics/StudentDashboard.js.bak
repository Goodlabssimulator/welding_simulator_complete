import React, { useEffect, useState, useCallback } from 'react';
import { useNavigate } from 'react-router-dom';
import { analyticsAPI } from '../../utils/apiClient';
import { useAuth } from '../../hooks/useAuth';
import TrendChart from './TrendChart';
import CompetencyChart from './CompetencyChart';

// ---------- helpers ----------
const num = (v, fallback = 0) => {
  const n = Number(v);
  return Number.isFinite(n) ? n : fallback;
};

const int = (v, fallback = 0) => Math.round(num(v, fallback));

/**
 * Build a normalized dashboard model from the three backend responses.
 */
function normalize({ summaryRes, trendsRes, competenciesRes }) {
  const summary = summaryRes?.data?.summary || {};
  const skillBreakdown = summaryRes?.data?.skillBreakdown || {};
  const trends = trendsRes?.data?.trends || [];
  const competenciesRaw = competenciesRes?.data?.competencies || [];

  const totalSessions = int(summary.total_attempts);
  const avgScore = num(summary.avg_score);
  const bestScore = num(summary.best_score);

  const gradeDistribution = {
    Distinction: int(summary.distinctions),
    Credit: int(summary.credits),
    Pass: int(summary.passes),
    Fail: int(summary.fails),
  };

  const scoresOverTime = trends.map((t) => ({
    date: typeof t.date === 'string' ? t.date.slice(5) : t.date, // YYYY-MM-DD -> MM-DD
    score: num(t.avg_score),
    attempts: int(t.attempts),
  }));

  const competencies = competenciesRaw.map((c) => ({
    code: c.code,
    name: c.name,
    category: c.category,
    level: c.level,
    score: num(c.score),
  }));

  const creditPlus = gradeDistribution.Distinction + gradeDistribution.Credit;

  return {
    totalSessions,
    avgScore,
    bestScore,
    gradeDistribution,
    creditPlus,
    scoresOverTime,
    competencies,
    skillBreakdown: {
      'Speed Accuracy': num(skillBreakdown.speed_accuracy),
      'Bead Quality': num(skillBreakdown.bead_quality),
      'Fusion Quality': num(skillBreakdown.fusion_quality),
      'Penetration': num(skillBreakdown.penetration),
      'Alignment': num(skillBreakdown.alignment),
      'Consistency': num(skillBreakdown.consistency),
      'Process Control': num(skillBreakdown.process_control),
    },
  };
}

export default function StudentDashboard() {
  const { user } = useAuth();
  const navigate = useNavigate();
  const [analytics, setAnalytics] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  const load = useCallback(async () => {
    if (!user?.id) return;
    setLoading(true);
    setError(null);
    try {
      const [summaryRes, trendsRes, competenciesRes] = await Promise.all([
        analyticsAPI.getStudentSummary(user.id),
        analyticsAPI.getStudentTrends(user.id, { days: 60 }),
        analyticsAPI.getStudentCompetencies(user.id),
      ]);
      setAnalytics(normalize({ summaryRes, trendsRes, competenciesRes }));
    } catch (err) {
      console.error('Failed to load analytics:', err);
      setError(err?.error || err?.message || 'Failed to load analytics');
      setAnalytics(null);
    } finally {
      setLoading(false);
    }
  }, [user?.id]);

  useEffect(() => {
    load();
  }, [load]);

  if (loading) {
    return <div className="dashboard-loading">Loading your analytics…</div>;
  }

  if (error) {
    return (
      <div className="dashboard-error">
        <p>Could not load analytics: {error}</p>
        <button className="btn btn-primary" onClick={load}>Retry</button>
      </div>
    );
  }

  if (!analytics || analytics.totalSessions === 0) {
    return (
      <div className="student-dashboard">
        <div className="dashboard-header">
        <h2>My Learning Dashboard</h2>
        <button
          className="btn btn-secondary"
          onClick={() => navigate('/student/progress')}
        >
          View All Sessions
        </button>
      </div>
        <div className="empty-state">
          <p>You haven't completed any welding sessions yet.</p>
          <p>Start welding to see your progress and competency tracking here.</p>
          <a className="btn btn-primary" href="/welding">Start Your First Session</a>
        </div>
      </div>
    );
  }

  return (
    <div className="student-dashboard">
      <h2>My Learning Dashboard</h2>

      <div className="stat-cards">
        <div className="stat-card">
          <span className="stat-card-value">{analytics.totalSessions}</span>
          <span className="stat-card-label">Sessions Completed</span>
        </div>
        <div className="stat-card">
          <span className="stat-card-value">{analytics.avgScore.toFixed(0)}</span>
          <span className="stat-card-label">Average Score</span>
        </div>
        <div className="stat-card">
          <span className="stat-card-value">{analytics.bestScore.toFixed(0)}</span>
          <span className="stat-card-label">Best Score</span>
        </div>
        <div className="stat-card accent-green">
          <span className="stat-card-value">{analytics.creditPlus}</span>
          <span className="stat-card-label">Credit+ Grades</span>
        </div>
      </div>

      <div className="chart-row">
        <div className="chart-card">
          <h3>Score Progression</h3>
          {analytics.scoresOverTime.length > 0 ? (
            <TrendChart data={analytics.scoresOverTime} />
          ) : (
            <p className="chart-empty">Not enough data yet.</p>
          )}
        </div>
        <div className="chart-card">
          <h3>Competency Status</h3>
          {analytics.competencies.length > 0 ? (
            <CompetencyChart competencies={analytics.competencies} />
          ) : (
            <p className="chart-empty">No competency records yet.</p>
          )}
        </div>
      </div>

      <div className="skill-breakdown">
        <h3>Skill Breakdown</h3>
        <div className="skill-grid">
          {Object.entries(analytics.skillBreakdown).map(([label, value]) => (
            <div key={label} className="skill-row">
              <span className="skill-label">{label}</span>
              <div className="skill-bar-track">
                <div
                  className="skill-bar-fill"
                  style={{
                    width: `${value}%`,
                    background:
                      value >= 75 ? '#10b981' :
                      value >= 60 ? '#f59e0b' :
                      value >= 40 ? '#3b82f6' : '#ef4444',
                  }}
                />
              </div>
              <span className="skill-value">{value.toFixed(0)}</span>
            </div>
          ))}
        </div>
      </div>

      <div className="competency-table-wrap">
        <h3>Competency Details</h3>
        <table className="competency-table">
          <thead>
            <tr>
              <th>Code</th>
              <th>Competency</th>
              <th>Score</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {analytics.competencies.map((c) => (
              <tr key={c.code}>
                <td><code>{c.code}</code></td>
                <td>{c.name}</td>
                <td>{c.score.toFixed(0)}</td>
                <td>
                  <span className={`competency-badge ${c.level}`}>
                    {c.level.replace(/_/g, ' ')}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
